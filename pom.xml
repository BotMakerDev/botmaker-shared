<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.LiQiyeDev (not com.botmaker.shared) on purpose: JitPack always serves this
      repo as com.github.LiQiyeDev:botmaker-shared:<tag> regardless of the pom, so matching that here
      makes the umbrella reactor's GAV identical to the published GAV. That lets one dependency line in
      the SDK/Studio resolve locally (reactor, version 0.0.0-SNAPSHOT) *and* from JitPack (a real tag).
      The version below is cosmetic — JitPack overrides it with the git tag on tag builds.
    -->
    <groupId>com.github.LiQiyeDev</groupId>
    <artifactId>botmaker-shared</artifactId>
    <version>0.0.0-SNAPSHOT</version>

    <!--
      Cross-platform native window plumbing (enumerate / capture / focus / move / resize / input)
      shared by the BotMaker SDK (runtime) and the BotMaker Studio (editor). Depends only on JNA;
      no JavaFX, no OpenCV. Full-desktop capture backends deliberately live in the consumers, not here.
    -->
    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JNA (native Windows/Linux window + input control) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>

        <!--
          OpenCV — template matching and colour matching (com.botmaker.shared.opencv), used by BOTH
          consumers: the SDK's vision facades and Studio's editor-time template tools. Compile scope so
          Studio picks it up transitively without depending on the SDK.

          Tess4J and the two bytedeco natives are NOT here any more. They moved to botmaker-sdk in SDK
          1.2.0 along with com.botmaker.shared.ocr, which had exactly one caller in the whole codebase
          (the SDK's Text facade) and made every other consumer resolve an OCR engine it never called.
          The version-pinning note that stood here moved with them — read it in botmaker-sdk/pom.xml
          before bumping anything in that stack.
        -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!--
          Android-emulator transport (com.botmaker.shared.emulator): dadb is a pure-JVM ADB client, so there
          is no adb.exe / adb server to ship. Compile scope so both consumers get it transitively — the SDK
          drives the emulator at runtime, and Studio can later preview an emulator screen in the capture picker.
          Pulls org.jetbrains.kotlin:kotlin-stdlib (accepted cost of not shipping an adb binary).
        -->
        <dependency>
            <groupId>dev.mobile</groupId>
            <artifactId>dadb</artifactId>
            <version>1.2.9</version>
        </dependency>

        <!--
          Installed-game discovery (com.botmaker.shared.game): the Epic and Faugus launchers keep their
          catalogues as JSON manifests, so a scanner has to read JSON. Compile scope, and it costs the
          consumers nothing they did not already have — the SDK and Studio both declare jackson-databind
          2.17.0 themselves. It is a new transitive dependency for botmaker-session alone, which is why the
          version is kept in step with theirs rather than floated.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- Tests: JUnit Jupiter (see CLAUDE.md). Used by the ipc telemetry round-trip/loopback tests. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <!-- Surefire 3.x for JUnit 5 (Jupiter) test discovery. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- Source Plugin: attaches source code so consumers get Javadoc/code in their IDE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
