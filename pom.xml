<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.BotMakerDev (not com.botmaker.shared) on purpose: JitPack always serves this
      repo as com.github.BotMakerDev:botmaker-shared:<tag> regardless of the pom, so matching that here
      makes the umbrella reactor's GAV identical to the published GAV. That lets one dependency line in
      the SDK/Studio resolve locally (reactor, this -SNAPSHOT) *and* from JitPack (a released version).
      The version below is real: -SNAPSHOT on main, the release version on a tag; only the release moves it
      (umbrella docs/refactor/43-real-versions.md).
    -->
    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-shared</artifactId>
    <version>0.10.2-SNAPSHOT</version>
    <licenses>
        <license>
            <name>PolyForm-Noncommercial-1.0.0</name>
            <url>https://polyformproject.org/licenses/noncommercial/1.0.0</url>
        </license>
    </licenses>

    <!--
      Cross-platform native window plumbing (enumerate / capture / focus / move / resize / input)
      shared by the BotMaker SDK (runtime) and the BotMaker Studio (editor). Depends only on JNA;
      no JavaFX, no OpenCV. Full-desktop capture backends deliberately live in the consumers, not here.
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The run log's format (botmaker-runlog): its writer, every format's reader. -->
        <botmaker.runlog.version>0.2.1-SNAPSHOT</botmaker.runlog.version>
        <!-- Tests tagged @Tag("slow") start a real browser (web/): left out by default, run by
             -Dgroups=slow -Dsurefire.excludedGroups= -->
        <surefire.excludedGroups>slow</surefire.excludedGroups>
    </properties>

    <!-- botmaker-runlog is shared's first dependency served only by JitPack: without this repository, JitPack's
         build of v0.7.0 looked for it on Central alone and failed. Not flattened away: this pom is published
         as written, and a consumer reaches the transitive runlog through it. -->
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- JNA (native Windows/Linux window + input control) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.14.0</version>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.14.0</version>
        </dependency>
        <!--
          The OS credential store (Windows Credential Manager, Secret Service, Keychain) for the Google passwords the
          user asks BotMaker to remember (emulator.google.KeyringStore). 1.0.4 pins JNA 5.13; ours above wins.
        -->
        <dependency>
            <groupId>com.github.javakeyring</groupId>
            <artifactId>java-keyring</artifactId>
            <version>1.0.4</version>
        </dependency>

        <!--
          OpenCV — template matching and colour matching (com.botmaker.shared.opencv), used by BOTH
          consumers: the SDK's vision facades and Studio's editor-time template tools. Compile scope so
          Studio picks it up transitively without depending on the SDK.

          Tess4J and the two bytedeco natives are NOT here any more. They moved to botmaker-sdk in SDK
          1.2.0 along with com.botmaker.shared.ocr, which had exactly one caller in the whole codebase
          (the SDK's Text facade) and made every other consumer resolve an OCR engine it never called.
          The version-pinning note that stood here moved with them — read it in botmaker-sdk/pom.xml
          before bumping anything in that stack.
        -->
        <dependency>
            <groupId>org.openpnp</groupId>
            <artifactId>opencv</artifactId>
            <version>4.9.0-0</version>
        </dependency>

        <!--
          Android-emulator transport (com.botmaker.shared.emulator): dadb is a pure-JVM ADB client, so there
          is no adb.exe / adb server to ship. Compile scope so both consumers get it transitively — the SDK
          drives the emulator at runtime, and Studio can later preview an emulator screen in the capture picker.
          Pulls org.jetbrains.kotlin:kotlin-stdlib (accepted cost of not shipping an adb binary).
        -->
        <dependency>
            <groupId>dev.mobile</groupId>
            <artifactId>dadb</artifactId>
            <version>1.2.9</version>
        </dependency>

        <!--
          Installed-game discovery (com.botmaker.shared.game): the Epic and Faugus launchers keep their
          catalogues as JSON manifests, so a scanner has to read JSON. Compile scope, and it costs the
          consumers nothing they did not already have — the SDK and Studio both declare jackson-databind
          2.17.0 themselves. It is a new transitive dependency for botmaker-session alone, which is why the
          version is kept in step with theirs rather than floated.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.0</version>
        </dependency>

        <!-- A run's run.jsonl: shared's Diag writes it, the CLI and Studio read it (docs/superpowers/specs/2026-11-03-run-reports-design.md §6). -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-runlog</artifactId>
            <version>${botmaker.runlog.version}</version>
        </dependency>

        <!--
          Web discovery's read-only guard (com.botmaker.shared.web): the public suffix list a scope is judged by
          (EffectiveTldFinder, the list shipped in the jar, nothing fetched) and robots.txt's parser
          (SimpleRobotRulesParser). Apache-2.0. It brings commons-io and slf4j-api, no slf4j provider: nothing in
          it starts or logs by itself.
        -->
        <dependency>
            <groupId>com.github.crawler-commons</groupId>
            <artifactId>crawler-commons</artifactId>
            <version>1.6</version>
        </dependency>

        <!--
          The web target's browser (com.botmaker.shared.web, spec docs/superpowers/specs/2026-11-21-playwright-web-design.md):
          Playwright for Java and its own Chromium, installed into UserDirs.cache()/playwright. Apache-2.0. Its driver
          bundle (a Node runtime per platform) starts only when a web target opens a browser.
          ChromiumInstall links Playwright's internal com.microsoft.playwright.impl.driver.Driver (to run
          `install chromium` with progress): check it still compiles on each upgrade.
        -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.64.0</version>
        </dependency>

        <!-- Tests: JUnit Jupiter (see CLAUDE.md). Used by the ipc telemetry round-trip/loopback tests. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Tests: a Linux game VM's answer is YAML, read in its guest only; LinuxAutoinstallTest parses it here. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <!-- Surefire 3.x for JUnit 5 (Jupiter) test discovery. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <!-- Source Plugin: attaches source code so consumers get Javadoc/code in their IDE -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
